# Database
# Leave both unset to use SQLite at backend/portfolio.db for local development.
# JAWSDB_URL="mysql://user:password@host:3306/database"
# DATABASE_URL="mysql+pymysql://user:password@localhost:3306/portfolio_db"

# JWT
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Admin credentials for /admin
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me

# Cloudinary (project images + CV uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis (optional; rate limiting falls back to in-memory)
REDIS_URL=redis://localhost:6379/0

# CORS (comma-separated frontend origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://portfolio-eta-flax-91.vercel.app

# Brevo contact notification email (optional)
BREVO_API_KEY=
BREVO_SENDER_NAME=Portfolio
BREVO_SENDER_EMAIL=you@example.com
